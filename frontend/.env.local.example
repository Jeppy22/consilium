# Functions backend URL. Local dev default is the Functions Core Tools port.
FUNCTIONS_BASE_URL=http://localhost:7071

# Shared secret sent as x-api-key when proxying to Functions.
# MUST match the CONSILIUM_API_KEY value in functions/local.settings.json.
# Server-side only — never expose with NEXT_PUBLIC_ prefix.
CONSILIUM_API_KEY=local-dev-shared-secret-change-me
